{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "lib": [
      "DOM",
      "ES2021"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*",
    "src/node_modules/**/*"
  ],
  "exclude": [
    "node_modules/*",
    "static/*",
    "src/service-worker.ts",
    "src/service-worker.d.ts"
  ]
}